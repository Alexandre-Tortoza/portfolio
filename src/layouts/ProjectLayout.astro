---
import '@styles/global.css'
import { ViewTransitions } from 'astro:transitions'
import FloatingLinks from '@components/FloatingLinks.astro'

export interface ProjectProps {
  lang?: string
  title: string
  description?: string
  date?: string
  tags?: string[]
  slug?: string
}

const {
  lang = 'pt-br',
  title,
  description = '',
  date = '',
  tags = [],
  slug = ''
} = Astro.props as ProjectProps
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions fallback="none" />

    {description && (
      <meta name="description" content={description} />
    )}
  </head>

  <body class="bg-plato-950 text-plato-50">
    <main class="max-w-3xl mx-auto px-6 py-16">
      <a href="/" class="inline-flex items-center gap-2 text-sm mb-8 hover:text-plato-300 transition-colors duration-300" transition:name="back-button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Voltar
      </a>
      <header class="mb-12">
        <h1 class="text-3xl font-bold mb-2" transition:name={`project-title-${slug}`}>{title}</h1>

        {date && (
          <p class="text-sm opacity-70">
            {date}
          </p>
        )}

        {description && (
          <p class="mt-4 text-base opacity-80">
            {description}
          </p>
        )}

        {tags.length > 0 && (
          <ul class="flex flex-wrap gap-2 mt-6">
            {tags.map(tag => (
              <li class="text-xs px-3 py-1 rounded bg-plato-800">
                {tag}
              </li>
            ))}
          </ul>
        )}
      </header>

      <article class="prose prose-invert max-w-none">
        <slot />
      </article>
    </main>

    <FloatingLinks />
  </body>
</html>
