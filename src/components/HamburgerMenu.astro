---

<div class="md:hidden">
  <!-- Hamburguer Button -->
  <button 
    id="hamburger-btn" 
    class="fixed top-6 right-6 z-50 p-3 rounded-xl border border-plato-700 bg-plato-950/90 backdrop-blur-md hover:bg-plato-900 transition-all duration-500 ease-out opacity-0 pointer-events-none"
    aria-label="Menu"
  >
    <svg 
      id="hamburger-icon"
      class="w-6 h-6 stroke-current" 
      fill="none" 
      viewBox="0 0 24 24" 
      stroke="currentColor"
    >
      <path 
        stroke-linecap="round" 
        stroke-linejoin="round" 
        stroke-width="2" 
        d="M4 6h16M4 12h16M4 18h16"
      />
    </svg>
    <svg 
      id="close-icon"
      class="w-6 h-6 stroke-current hidden" 
      fill="none" 
      viewBox="0 0 24 24" 
      stroke="currentColor"
    >
      <path 
        stroke-linecap="round" 
        stroke-linejoin="round" 
        stroke-width="2" 
        d="M6 18L18 6M6 6l12 12"
      />
    </svg>
  </button>

  <!-- Sidebar Overlay -->
  <div 
    id="sidebar-overlay" 
    class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300"
  ></div>

  <!-- Sidebar -->
  <nav 
    id="sidebar" 
    class="fixed left-0 top-0 h-screen w-64 bg-plato-950 z-40 transform -translate-x-full transition-transform duration-300 shadow-2xl"
  >
    <!-- Sidebar Header -->
    <div class="p-6 border-b border-plato-800">
      <h2 class="text-xl font-bold text-plato-100">Menu</h2>
    </div>

    <!-- Sidebar Links -->
    <ul class="flex flex-col gap-0 p-0 mt-4">
      <li>
        <a 
          href="#home" 
          class="sidebar-link block px-6 py-4 hover:bg-plato-900 transition-colors border-b border-plato-800 text-plato-100"
        >
          Home
        </a>
      </li>
      <li>
        <a 
          href="#sobre" 
          class="sidebar-link block px-6 py-4 hover:bg-plato-900 transition-colors border-b border-plato-800 text-plato-100"
        >
          Sobre mim
        </a>
      </li>
      <li>
        <a 
          href="#projetos" 
          class="sidebar-link block px-6 py-4 hover:bg-plato-900 transition-colors border-b border-plato-800 text-plato-100"
        >
          Projetos
        </a>
      </li>
      <li>
        <a 
          href="#contato" 
          class="sidebar-link block px-6 py-4 hover:bg-plato-900 transition-colors text-plato-100"
        >
          Contato
        </a>
      </li>
    </ul>
  </nav>
</div>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const sidebar = document.getElementById("sidebar");
  const sidebarOverlay = document.getElementById("sidebar-overlay");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");
  const sidebarLinks = document.querySelectorAll(".sidebar-link");

  const SCROLL_THRESHOLD = 100; // Pixels para aparecer o botão

  function toggleSidebar() {
    const isOpen = !sidebar?.classList.contains("-translate-x-full");
    
    if (isOpen) {
      closeSidebar();
    } else {
      openSidebar();
    }
  }

  function openSidebar() {
    sidebar?.classList.remove("-translate-x-full");
    sidebarOverlay?.classList.remove("opacity-0", "pointer-events-none");
    sidebarOverlay?.classList.add("opacity-100", "pointer-events-auto");
    hamburgerIcon?.classList.add("hidden");
    closeIcon?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeSidebar() {
    sidebar?.classList.add("-translate-x-full");
    sidebarOverlay?.classList.add("opacity-0", "pointer-events-none");
    sidebarOverlay?.classList.remove("opacity-100", "pointer-events-auto");
    hamburgerIcon?.classList.remove("hidden");
    closeIcon?.classList.add("hidden");
    document.body.style.overflow = "";
  }

  function handleScroll() {
    if (hamburgerBtn) {
      if (window.scrollY > SCROLL_THRESHOLD) {
        // Mostra o botão após rolar
        hamburgerBtn.classList.remove("opacity-0", "pointer-events-none");
        hamburgerBtn.classList.add("opacity-100", "pointer-events-auto");
      } else {
        // Esconde o botão no topo
        hamburgerBtn.classList.add("opacity-0", "pointer-events-none");
        hamburgerBtn.classList.remove("opacity-100", "pointer-events-auto");
      }
    }
  }

  hamburgerBtn?.addEventListener("click", toggleSidebar);
  sidebarOverlay?.addEventListener("click", closeSidebar);

  sidebarLinks?.forEach((link) => {
    link.addEventListener("click", () => {
      closeSidebar();
    });
  });

  window.addEventListener("scroll", handleScroll);
  handleScroll();
</script>
